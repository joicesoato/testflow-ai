# Aplicação
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
APP_URL=https://seu-dominio-configurado

# MariaDB (credenciais fornecidas pelo ambiente de hospedagem)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Autenticação e comunicação interna — gerar valores fortes e únicos
AUTH_PORT=3001
JWT_SECRET=
SESSION_SECRET=
INTERNAL_SERVICE_SECRET=

# Serviço de e-mail (necessário quando a autenticação for integrada)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
EMAIL_VERIFICATION_REQUIRED=true

AUTH_SERVICE_URL=http://auth-service:3001
LOG_SERVICE_URL=http://log-service:3002

# MinIO — nunca publicar estas credenciais
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=testflow-evidencias
MINIO_REGION=us-east-1

# Gemini — IA generativa para sugerir e salvar casos de teste
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe — configure chaves de teste e um preço recorrente no Dashboard Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
